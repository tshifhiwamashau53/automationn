{
  "name": "auto-deploy-php/auto-deploy",
  "description": "Professional automatic PHP deployment system with GitHub webhooks, rollback, notifications, and security",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Auto Deploy PHP Contributors",
      "email": "info@autodeployphp.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-zip": "*",
    "symfony/process": "^6.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpstan/phpstan": "^1.9",
    "friendsofphp/php-cs-fixer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "AutoDeployPHP\\": "src/AutoDeployPHP/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AutoDeployPHP\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse src --level=9",
    "fix": "php-cs-fixer fix src --rules=@PSR12",
    "check": "@stan && @test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist"
  }
}
